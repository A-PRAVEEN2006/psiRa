<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#121212">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Unit &amp; Metric Converter"
            android:textColor="#FFFFFF"
            android:textSize="22sp"
            android:textStyle="bold"
            android:layout_marginBottom="4dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Fast offline engineering conversion"
            android:textColor="#888888"
            android:textSize="13sp"
            android:layout_marginBottom="24dp" />

        <!-- Conversion Mode Selection Chips -->
        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:scrollbars="none"
            android:layout_marginBottom="24dp">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btnModeMeters"
                    android:layout_width="wrap_content"
                    android:layout_height="38dp"
                    android:text="m → ft"
                    android:textSize="12sp"
                    android:backgroundTint="#2C2C2E"
                    android:textColor="#FFFFFF"
                    android:layout_marginEnd="8dp" />

                <Button
                    android:id="@+id/btnModeKm"
                    android:layout_width="wrap_content"
                    android:layout_height="38dp"
                    android:text="km → mi"
                    android:textSize="12sp"
                    android:backgroundTint="#1C1C1E"
                    android:textColor="#888888"
                    android:layout_marginEnd="8dp" />

                <Button
                    android:id="@+id/btnModeKg"
                    android:layout_width="wrap_content"
                    android:layout_height="38dp"
                    android:text="kg → lb"
                    android:textSize="12sp"
                    android:backgroundTint="#1C1C1E"
                    android:textColor="#888888"
                    android:layout_marginEnd="8dp" />

                <Button
                    android:id="@+id/btnModeTemp"
                    android:layout_width="wrap_content"
                    android:layout_height="38dp"
                    android:text="°C → °F"
                    android:textSize="12sp"
                    android:backgroundTint="#1C1C1E"
                    android:textColor="#888888" />
            </LinearLayout>
        </HorizontalScrollView>

        <TextView
            android:id="@+id/tvInputLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Input Value (Meters)"
            android:textColor="#AAAAAA"
            android:textSize="13sp"
            android:layout_marginBottom="8dp" />

        <EditText
            android:id="@+id/etInput"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:background="#1E1E1E"
            android:textColor="#FFFFFF"
            android:textColorHint="#555555"
            android:paddingHorizontal="16dp"
            android:hint="e.g. 50"
            android:inputType="numberDecimal|numberSigned"
            android:textSize="18sp"
            android:layout_marginBottom="16dp" />

        <Button
            android:id="@+id/btnConvert"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:text="CONVERT"
            android:textStyle="bold"
            android:textSize="15sp"
            android:backgroundTint="#007AFF"
            android:textColor="#FFFFFF"
            android:layout_marginBottom="24dp" />

        <ImageView
            android:id="@+id/ivConvert"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:visibility="gone" />

        <!-- Output Card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#1C1C1E"
            android:padding="20dp"
            android:gravity="center">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="CONVERTED RESULT"
                android:textColor="#8E8E93"
                android:textSize="11sp"
                android:textStyle="bold"
                android:layout_marginBottom="8dp" />

            <TextView
                android:id="@+id/tvOutput"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0.00 ft"
                android:textColor="#34C759"
                android:textSize="32sp"
                android:textStyle="bold" />
        </LinearLayout>

    </LinearLayout>
</ScrollView>
