<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/cardTheme"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="10dp"
    app:cardCornerRadius="14dp"
    app:cardElevation="2dp"
    app:cardBackgroundColor="#1A1A1A">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="14dp">

        <!-- Theme Color Swatch Circle -->
        <View
            android:id="@+id/viewColorDot"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="@drawable/bg_circle_dark" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="14dp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvThemeTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Midnight Amethyst"
                android:textColor="#FFFFFF"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvThemeDesc"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="#B388FF • Royal Cryptography"
                android:textColor="#888888"
                android:textSize="12sp" />
        </LinearLayout>

        <!-- Selected Checkmark Badge -->
        <TextView
            android:id="@+id/tvThemeSelectedBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="✓ ACTIVE"
            android:textColor="#00E676"
            android:textSize="11sp"
            android:textStyle="bold"
            android:background="@drawable/bg_unread_badge"
            android:backgroundTint="#1B3820"
            android:paddingHorizontal="8dp"
            android:paddingVertical="3dp"
            android:visibility="gone" />

    </LinearLayout>
</androidx.cardview.widget.CardView>
