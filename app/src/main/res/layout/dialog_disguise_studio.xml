<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="20dp"
    android:background="#121212">

    <!-- Handle Bar -->
    <View
        android:layout_width="40dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:background="#333333"
        android:layout_marginBottom="16dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="14dp">

        <TextView
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:text="🕵️ DISGUISE STUDIO"
            android:textColor="#FFFFFF"
            android:textSize="18sp"
            android:textStyle="bold"
            android:letterSpacing="0.04" />

        <TextView
            android:id="@+id/tvDisguiseStudioHelp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Tap to apply • ⚙️ to edit"
            android:textColor="#888888"
            android:textSize="12sp" />
    </LinearLayout>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Select an app disguise below. PsiRa will masquerade as this utility on your home screen and app launcher. Tap any disguise to apply, or tap ⚙️ to customize unlock codes."
        android:textColor="#AAAAAA"
        android:textSize="13sp"
        android:lineSpacingExtra="2dp"
        android:layout_marginBottom="16dp" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvDisguises"
        android:layout_width="match_parent"
        android:layout_height="380dp"
        android:nestedScrollingEnabled="true"
        android:clipToPadding="false" />

    <Button
        android:id="@+id/btnDoneDisguiseStudio"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_marginTop="12dp"
        android:text="CLOSE STUDIO"
        android:textColor="#FFFFFF"
        android:textStyle="bold"
        android:background="@drawable/bg_rounded_primary" />

</LinearLayout>
