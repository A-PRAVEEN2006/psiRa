<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0F0C29">

    <!-- Discovery Header -->
    <LinearLayout
        android:id="@+id/discoveryHeader"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp"
        android:background="#1A1A2E"
        app:layout_constraintTop_toTopOf="parent">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="TACTICAL MESH LINK"
            android:textColor="?attr/colorPrimary"
            android:textStyle="bold"
            android:textSize="18sp"
            android:gravity="center"
            android:layout_marginBottom="16dp"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnAdvertise"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="BROADCAST"
                android:backgroundTint="#00FF00"
                android:textColor="#000000"
                android:textSize="12sp"
                android:layout_marginEnd="8dp"/>

            <Button
                android:id="@+id/btnDiscover"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="SCAN NODES"
                android:backgroundTint="?attr/colorPrimary"
                android:textColor="#FFFFFF"
                android:textSize="12sp"/>
        </LinearLayout>
    </LinearLayout>

    <!-- Message List -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvBluetoothMessages"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintTop_toBottomOf="@id/discoveryHeader"
        app:layout_constraintBottom_toTopOf="@id/btInputBar"
        android:padding="12dp"
        android:clipToPadding="false"/>

    <!-- Status Strip -->
    <TextView
        android:id="@+id/tvBTStatus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="STATUS: DISCONNECTED"
        android:textColor="#FF3B30"
        android:textSize="10sp"
        android:gravity="center"
        android:padding="4dp"
        android:background="#000000"
        app:layout_constraintBottom_toTopOf="@id/btInputBar"/>

    <!-- Input Bar -->
    <LinearLayout
        android:id="@+id/btInputBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="12dp"
        android:background="#1A1A2E"
        app:layout_constraintBottom_toBottomOf="parent">

        <EditText
            android:id="@+id/etBTMessage"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:hint="Signal..."
            android:textColor="#FFFFFF"
            android:textColorHint="#666666"
            android:background="@null"
            android:padding="12dp"
            android:inputType="textShortMessage" />

        <Button
            android:id="@+id/btnBTSend"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="SEND"
            android:backgroundTint="?attr/colorPrimary"
            android:enabled="false"/>
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
