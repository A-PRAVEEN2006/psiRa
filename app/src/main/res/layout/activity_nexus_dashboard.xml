<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?android:attr/colorBackground">

    <LinearLayout
        android:id="@+id/mainContentContainer"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:orientation="vertical"
        android:padding="24dp"
        android:alpha="0.0"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@id/bottomNav">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="40dp">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_alignParentStart="true">
                
                <TextView
                    android:id="@+id/tvAgentName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="USER: LOADING..."
                    android:textColor="?attr/colorOnBackground"
                    android:textSize="12sp"
                    android:letterSpacing="0.05" />
                    
                <TextView
                    android:id="@+id/tvAgentId"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="ID: [LOADING...]"
                    android:textColor="?attr/colorAccent"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.1" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvLogout"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="LOG OUT"
                android:textColor="?attr/colorError"
                android:textSize="12sp"
                android:textStyle="bold"
                android:clickable="true"
                android:focusable="true"
                android:layout_alignParentEnd="true" />
        </RelativeLayout>

        <TextView
            android:id="@+id/nexusTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="PsiRa"
            android:textColor="?attr/colorPrimary"
            android:textSize="42sp"
            android:textStyle="bold"
            android:gravity="center"
            android:layout_marginTop="20dp"
            android:layout_marginBottom="8dp" />

        <!-- TOR Status Pill — only visible when TOR is ON -->
        <TextView
            android:id="@+id/tvTorBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🧅  TOR ACTIVE — IP HIDDEN"
            android:textColor="#CE93D8"
            android:textSize="11sp"
            android:textStyle="bold"
            android:background="#331A0A2E"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:paddingTop="4dp"
            android:paddingBottom="4dp"
            android:gravity="center"
            android:layout_gravity="center"
            android:layout_marginBottom="40dp"
            android:visibility="gone"/>

        <Button
            android:id="@+id/btnGlobal"
            android:layout_width="match_parent"
            android:layout_height="75dp"
            android:text="📡 Global Chat"
            android:background="@drawable/bg_rounded_primary"
            android:backgroundTint="?attr/colorPrimary"
            android:textColor="#FFFFFF"
            android:textSize="18sp"
            android:textStyle="bold"
            android:layout_marginBottom="24dp" />

        <Button
            android:id="@+id/btnWalkie"
            android:layout_width="match_parent"
            android:layout_height="75dp"
            android:text="📻 Private Channel"
            android:backgroundTint="?attr/colorSurface"
            android:textColor="?attr/colorAccent"
            android:textSize="18sp"
            android:textStyle="bold"
            android:elevation="4dp"
            android:layout_marginBottom="24dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="24dp">

            <Button
                android:id="@+id/btnBluetooth"
                android:layout_width="0dp"
                android:layout_height="75dp"
                android:layout_weight="1"
                android:text="🌀 BLUETOOTH"
                android:backgroundTint="#0D47A1"
                android:textColor="#FFFFFF"
                android:textStyle="bold"
                android:textSize="12sp"
                android:layout_marginEnd="8dp" />

            <Button
                android:id="@+id/btnWifiMesh"
                android:layout_width="0dp"
                android:layout_height="75dp"
                android:layout_weight="1"
                android:text="💠 WI-FI MESH"
                android:backgroundTint="#006064"
                android:textColor="#FFFFFF"
                android:textStyle="bold"
                android:textSize="12sp"
                android:layout_marginStart="8dp" />
        </LinearLayout>

        <Button
            android:id="@+id/btnNexusLink"
            android:layout_width="match_parent"
            android:layout_height="85dp"
            android:text="🛰️ UNIFIED MESSAGES"
            android:backgroundTint="@color/psira_accent"
            android:textColor="#000000"
            android:textSize="18sp"
            android:textStyle="bold"
            android:elevation="8dp"
            android:visibility="gone"
            android:layout_marginBottom="24dp" />

        <TextView
            android:id="@+id/tvStatusIndicator"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="STATUS: ONLINE"
            android:textColor="#00FF00"
            android:textSize="14sp"
            android:textStyle="bold"
            android:gravity="center"
            android:layout_marginBottom="16dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Your messages are safe and fully encrypted."
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:gravity="center"
            android:alpha="0.7" />

    </LinearLayout>

    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottomNav"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?attr/colorSurface"
        app:itemIconTint="?attr/colorPrimary"
        app:itemTextColor="?attr/colorPrimary"
        app:menu="@menu/menu_bottom_nav"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>