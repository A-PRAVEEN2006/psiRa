<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <!-- Ghost Header -->
    <LinearLayout
        android:id="@+id/ghostHeader"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp"
        android:background="#0A0A0A"
        app:layout_constraintTop_toTopOf="parent">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="GHOST NETWORK (ELITE RANGE)"
            android:textColor="#00FF00"
            android:textStyle="bold"
            android:textSize="18sp"
            android:gravity="center"
            android:layout_marginBottom="16dp"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnDiscoverGhost"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="INITIATE NODE DISCOVERY"
                android:backgroundTint="#00FF00"
                android:textColor="#000000"
                android:textStyle="bold"
                android:padding="12dp"/>
        </LinearLayout>
    </LinearLayout>

    <!-- Signal List -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvGhostMessages"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintTop_toBottomOf="@id/ghostHeader"
        app:layout_constraintBottom_toTopOf="@id/ghostStatusStrip"
        android:padding="12dp"
        android:clipToPadding="false"/>

    <!-- Status Strip -->
    <TextView
        android:id="@+id/ghostStatusStrip"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="SIGNAL STATUS: COLD"
        android:textColor="#666666"
        android:textSize="10sp"
        android:gravity="center"
        android:padding="6dp"
        android:background="#111111"
        app:layout_constraintBottom_toTopOf="@id/ghostInputBar"/>

    <!-- Ghost Input Bar -->
    <LinearLayout
        android:id="@+id/ghostInputBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="12dp"
        android:background="#0A0A0A"
        app:layout_constraintBottom_toBottomOf="parent">

        <EditText
            android:id="@+id/etGhostMessage"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:hint="Broadcast encrypted signal..."
            android:textColor="#00FF00"
            android:textColorHint="#333333"
            android:background="@null"
            android:padding="12dp"
            android:inputType="textShortMessage" />

        <Button
            android:id="@+id/btnGhostSend"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="TRANSMIT"
            android:backgroundTint="#00FF00"
            android:textColor="#000000"
            android:enabled="false"/>
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
