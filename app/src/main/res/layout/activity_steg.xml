<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#1A1A2E"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <!-- HEADER -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp">

            <ImageButton
                android:id="@+id/btnBack"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@android:drawable/ic_menu_revert"
                android:contentDescription="Back"
                android:layout_alignParentStart="true"
                android:layout_centerVertical="true"
                android:tint="#7B61FF" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="IMAGE STEGANOGRAPHY"
                android:textColor="#7B61FF"
                android:textSize="12sp"
                android:textStyle="bold"
                android:letterSpacing="0.2"
                android:layout_centerInParent="true" />
        </RelativeLayout>

        <!-- TAB BUTTONS -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:orientation="horizontal"
            android:background="#121224"
            android:padding="4dp"
            android:layout_marginBottom="24dp"
            android:weightSum="2">

            <TextView
                android:id="@+id/tabConceal"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:text="CONCEAL"
                android:textColor="#FFFFFF"
                android:textSize="13sp"
                android:textStyle="bold"
                android:background="@drawable/bg_rounded_input"
                android:clickable="true"
                android:focusable="true"/>

            <TextView
                android:id="@+id/tabExtract"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:text="EXTRACT"
                android:textColor="#808080"
                android:textSize="13sp"
                android:textStyle="bold"
                android:clickable="true"
                android:focusable="true"/>
        </LinearLayout>

        <!-- CONTAINER FOR CONCEAL VIEW -->
        <LinearLayout
            android:id="@+id/layoutConceal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="visible">

            <!-- Pick Image Card -->
            <androidx.cardview.widget.CardView
                android:id="@+id/cardSelectConcealImage"
                android:layout_width="match_parent"
                android:layout_height="180dp"
                android:layout_marginBottom="20dp"
                app:cardCornerRadius="12dp"
                app:cardElevation="0dp"
                app:cardBackgroundColor="#121224">

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent">

                    <ImageView
                        android:id="@+id/ivConcealPreview"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:scaleType="centerInside"
                        android:visibility="gone" />

                    <LinearLayout
                        android:id="@+id/layoutConcealPlaceholder"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:layout_centerInParent="true">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="📸"
                            android:textSize="32sp"
                            android:layout_marginBottom="8dp"/>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Select Source Image"
                            android:textColor="#80FFFFFF"
                            android:textSize="14sp"
                            android:textStyle="bold"/>
                    </LinearLayout>
                </RelativeLayout>
            </androidx.cardview.widget.CardView>

            <!-- Message Input -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="SECRET MESSAGE"
                android:textColor="#7B61FF"
                android:textSize="11sp"
                android:textStyle="bold"
                android:letterSpacing="0.12"
                android:layout_marginBottom="6dp"/>

            <EditText
                android:id="@+id/etConcealMessage"
                android:layout_width="match_parent"
                android:layout_height="100dp"
                android:hint="Type your hidden communication..."
                android:textColor="#FFFFFF"
                android:textColorHint="#44FFFFFF"
                android:textSize="14sp"
                android:background="@drawable/bg_rounded_input"
                android:padding="12dp"
                android:gravity="top|start"
                android:layout_marginBottom="20dp"
                android:importantForAutofill="no"/>

            <!-- Key Input -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="ENCRYPTION KEY (OPTIONAL)"
                android:textColor="#7B61FF"
                android:textSize="11sp"
                android:textStyle="bold"
                android:letterSpacing="0.12"
                android:layout_marginBottom="6dp"/>

            <EditText
                android:id="@+id/etConcealKey"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Leave blank to use Group Key"
                android:textColor="#FFFFFF"
                android:textColorHint="#44FFFFFF"
                android:textSize="14sp"
                android:background="@drawable/bg_rounded_input"
                android:padding="12dp"
                android:inputType="textPassword"
                android:layout_marginBottom="24dp"
                android:importantForAutofill="no"/>

            <Button
                android:id="@+id/btnConcealAction"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:text="CONCEAL &amp; SAVE IMAGE"
                android:backgroundTint="#7B61FF"
                android:textColor="#FFFFFF"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- CONTAINER FOR EXTRACT VIEW -->
        <LinearLayout
            android:id="@+id/layoutExtract"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <!-- Pick Carrier Card -->
            <androidx.cardview.widget.CardView
                android:id="@+id/cardSelectExtractImage"
                android:layout_width="match_parent"
                android:layout_height="180dp"
                android:layout_marginBottom="20dp"
                app:cardCornerRadius="12dp"
                app:cardElevation="0dp"
                app:cardBackgroundColor="#121224">

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent">

                    <ImageView
                        android:id="@+id/ivExtractPreview"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:scaleType="centerInside"
                        android:visibility="gone" />

                    <LinearLayout
                        android:id="@+id/layoutExtractPlaceholder"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:layout_centerInParent="true">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="🖼️"
                            android:textSize="32sp"
                            android:layout_marginBottom="8dp"/>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Select Carrier Image"
                            android:textColor="#80FFFFFF"
                            android:textSize="14sp"
                            android:textStyle="bold"/>
                    </LinearLayout>
                </RelativeLayout>
            </androidx.cardview.widget.CardView>

            <!-- Key Input -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="DECRYPTION KEY (OPTIONAL)"
                android:textColor="#7B61FF"
                android:textSize="11sp"
                android:textStyle="bold"
                android:letterSpacing="0.12"
                android:layout_marginBottom="6dp"/>

            <EditText
                android:id="@+id/etExtractKey"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Leave blank if encrypted with Group Key"
                android:textColor="#FFFFFF"
                android:textColorHint="#44FFFFFF"
                android:textSize="14sp"
                android:background="@drawable/bg_rounded_input"
                android:padding="12dp"
                android:inputType="textPassword"
                android:layout_marginBottom="24dp"
                android:importantForAutofill="no"/>

            <Button
                android:id="@+id/btnExtractAction"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:text="EXTRACT &amp; DECRYPT"
                android:backgroundTint="#7B61FF"
                android:textColor="#FFFFFF"
                android:textStyle="bold"
                android:layout_marginBottom="24dp"/>

            <!-- Result Output -->
            <LinearLayout
                android:id="@+id/layoutResult"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="EXTRACTED MESSAGE"
                    android:textColor="#4CD964"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.12"
                    android:layout_marginBottom="6dp"/>

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="#121224"
                    android:padding="12dp"
                    android:layout_marginBottom="16dp">

                    <TextView
                        android:id="@+id/tvExtractedMessage"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textColor="#FFFFFF"
                        android:textSize="15sp"
                        android:layout_toStartOf="@id/btnCopyText"
                        android:layout_centerVertical="true"
                        android:paddingEnd="12dp"/>

                    <ImageButton
                        android:id="@+id/btnCopyText"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:layout_alignParentEnd="true"
                        android:layout_centerVertical="true"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:src="@android:drawable/ic_menu_save"
                        android:contentDescription="Copy to Clipboard"
                        android:tint="#4CD964"/>
                </RelativeLayout>
            </LinearLayout>
        </LinearLayout>

    </LinearLayout>
</ScrollView>
