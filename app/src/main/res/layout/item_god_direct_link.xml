<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="8dp"
    app:cardCornerRadius="8dp"
    app:cardBackgroundColor="#1B1B1B">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:id="@+id/tvGodLinkHeader"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="DIRECT LINK: SENDER - RECEIVER"
            android:textColor="#BC13FE"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvGodLinkLastMessage"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="[DECRYPTING...]"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:layout_marginTop="8dp" />

        <Button
            android:id="@+id/btnViewFullLink"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="HIJACK LOGS"
            android:textSize="12sp"
            android:backgroundTint="#333333"
            android:layout_marginTop="8dp"
            android:layout_gravity="end" />
    </LinearLayout>
</androidx.cardview.widget.CardView>
