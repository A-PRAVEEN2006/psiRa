<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/chatBg"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    android:background="#131324">

    <!-- Top Action Bar -->
    <ImageView
        android:id="@+id/btnCipherOrb"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_marginStart="14dp"
        android:layout_marginTop="12dp"
        android:src="@android:drawable/ic_menu_search"
        android:alpha="1.0"
        android:background="@drawable/bg_chat_btn_circle"
        android:padding="9dp"
        android:elevation="4dp"
        app:tint="#A78BFA"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        android:contentDescription="PsiRa Converter" />

    <TextView
        android:id="@+id/secureStatusText"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="● PSIRA SECURE MODE ACTIVE"
        android:textColor="#A78BFA"
        android:textSize="13sp"
        android:textStyle="bold"
        android:layout_marginStart="10dp"
        android:layout_marginEnd="6dp"
        android:ellipsize="end"
        android:maxLines="1"
        app:layout_constraintTop_toTopOf="@id/btnCipherOrb"
        app:layout_constraintBottom_toBottomOf="@id/btnCipherOrb"
        app:layout_constraintStart_toEndOf="@id/btnCipherOrb"
        app:layout_constraintEnd_toStartOf="@id/btnVoiceCall" />

    <ImageButton
        android:id="@+id/btnVoiceCall"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_marginEnd="6dp"
        android:background="@drawable/bg_chat_btn_circle"
        android:src="@android:drawable/ic_menu_call"
        android:contentDescription="Voice Call"
        android:padding="8dp"
        app:tint="#7B61FF"
        app:layout_constraintTop_toTopOf="@id/btnCipherOrb"
        app:layout_constraintBottom_toBottomOf="@id/btnCipherOrb"
        app:layout_constraintEnd_toStartOf="@id/btnSettings" />

    <ImageButton
        android:id="@+id/btnSettings"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_marginEnd="6dp"
        android:background="@drawable/bg_chat_btn_circle"
        android:src="@android:drawable/ic_menu_preferences"
        android:contentDescription="Settings"
        android:padding="8dp"
        app:tint="#A78BFA"
        app:layout_constraintTop_toTopOf="@id/btnCipherOrb"
        app:layout_constraintBottom_toBottomOf="@id/btnCipherOrb"
        app:layout_constraintEnd_toStartOf="@id/btnWipeChat" />

    <ImageButton
        android:id="@+id/btnWipeChat"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_marginEnd="14dp"
        android:background="@drawable/bg_chat_btn_circle"
        android:src="@android:drawable/ic_menu_delete"
        android:contentDescription="Wipe Chat"
        android:padding="8dp"
        app:tint="#FF4757"
        app:layout_constraintTop_toTopOf="@id/btnCipherOrb"
        app:layout_constraintBottom_toBottomOf="@id/btnCipherOrb"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Chat Messages Recycler -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerView"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="8dp"
        app:layout_constraintTop_toBottomOf="@+id/btnCipherOrb"
        app:layout_constraintBottom_toTopOf="@id/tvTypingIndicator"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:padding="8dp"
        android:clipToPadding="false"/>

    <!-- Typing Indicator -->
    <TextView
        android:id="@+id/tvTypingIndicator"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Agent is typing..."
        android:textSize="12sp"
        android:textStyle="italic"
        android:textColor="#79D7BE"
        android:visibility="gone"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:layout_marginBottom="4dp"
        app:layout_constraintBottom_toTopOf="@id/bottomInputBar"
        app:layout_constraintStart_toStartOf="parent" />

    <!-- Sleek Bottom Input Bar -->
    <LinearLayout
        android:id="@+id/bottomInputBar"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="10dp"
        android:paddingEnd="10dp"
        android:paddingTop="8dp"
        android:paddingBottom="10dp"
        android:background="#1A1A2E"
        android:elevation="8dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <ImageButton
            android:id="@+id/btnAttachMedia"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:background="@drawable/bg_chat_btn_circle"
            android:src="@android:drawable/ic_input_add"
            app:tint="#A78BFA"
            android:padding="9dp"
            android:layout_marginEnd="6dp"
            android:contentDescription="Attach Media" />

        <ImageButton
            android:id="@+id/btnRecordVoice"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:background="@drawable/bg_chat_btn_circle"
            android:src="@drawable/ic_cloak_recorder"
            app:tint="#A78BFA"
            android:padding="9dp"
            android:layout_marginEnd="8dp"
            android:contentDescription="Record Voice" />

        <EditText
            android:id="@+id/editMessage"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:minHeight="44dp"
            android:hint="Type a secure message..."
            android:textColorHint="#606085"
            android:textColor="#FFFFFF"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:paddingTop="10dp"
            android:paddingBottom="10dp"
            android:background="@drawable/bg_rounded_input"
            android:inputType="textShortMessage|textCapSentences|textMultiLine"
            android:maxLines="4" />

        <Button
            android:id="@+id/btnSend"
            android:layout_width="46dp"
            android:layout_height="46dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/bg_chat_send_circle"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:textStyle="bold"
            android:text="➤"
            android:gravity="center"
            android:padding="0dp" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
