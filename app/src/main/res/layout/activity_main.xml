<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#0D0D0D"
    android:padding="16dp"
    android:gravity="bottom">

    <EditText
        android:id="@+id/calcDisplay"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="24dp"
        android:background="@null"
        android:gravity="end"
        android:hint="0"
        android:inputType="none"
        android:textColor="#00FF00"
        android:textColorHint="#444444"
        android:textSize="48sp" />

    <GridLayout
        android:id="@+id/mainGrid"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:columnCount="4"
        android:rowCount="5">

        <Button android:id="@+id/btnClear" style="@style/CalcButton" android:text="C" android:textColor="#FF0000" />
        <Button android:id="@+id/btnDivide" style="@style/CalcButton" android:text="/" />
        <Button android:id="@+id/btnMultiply" style="@style/CalcButton" android:text="*" />
        <Button android:id="@+id/btnDel" style="@style/CalcButton" android:text="Del" />

        <Button android:id="@+id/btn7" style="@style/CalcButton" android:text="7" />
        <Button android:id="@+id/btn8" style="@style/CalcButton" android:text="8" />
        <Button android:id="@+id/btn9" style="@style/CalcButton" android:text="9" />
        <Button android:id="@+id/btnSubtract" style="@style/CalcButton" android:text="-" />

        <Button android:id="@+id/btn4" style="@style/CalcButton" android:text="4" />
        <Button android:id="@+id/btn5" style="@style/CalcButton" android:text="5" />
        <Button android:id="@+id/btn6" style="@style/CalcButton" android:text="6" />
        <Button android:id="@+id/btnAdd" style="@style/CalcButton" android:text="+" />

        <Button android:id="@+id/btn1" style="@style/CalcButton" android:text="1" />
        <Button android:id="@+id/btn2" style="@style/CalcButton" android:text="2" />
        <Button android:id="@+id/btn3" style="@style/CalcButton" android:text="3" />
        <Button android:id="@+id/btnEqual" style="@style/CalcButton" android:text="=" android:backgroundTint="#00FF00" android:textColor="#000000" />

        <Button android:id="@+id/btn0" style="@style/CalcButton" android:text="0" android:layout_columnSpan="2" android:layout_width="0dp" android:layout_gravity="fill_horizontal" />
        <Button style="@style/CalcButton" android:text="." />

    </GridLayout>

</LinearLayout>