<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#050002"
    android:padding="24dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_centerInParent="true"
        android:gravity="center"
        android:orientation="vertical">

        <!-- Glowing Red Alert Icon -->
        <TextView
            android:layout_width="90dp"
            android:layout_height="90dp"
            android:background="@drawable/bg_circle_red"
            android:gravity="center"
            android:text="🚫"
            android:textSize="40sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:letterSpacing="0.12"
            android:text="ACCESS REVOKED"
            android:textColor="#FF1744"
            android:textSize="22sp"
            android:textStyle="bold"
            android:fontFamily="monospace" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:letterSpacing="0.08"
            android:text="NODE TERMINATED BY OVERSEER"
            android:textColor="#FF8A80"
            android:textSize="12sp"
            android:fontFamily="monospace" />

        <View
            android:layout_width="160dp"
            android:layout_height="1dp"
            android:layout_marginTop="20dp"
            android:layout_marginBottom="20dp"
            android:background="#33FF1744" />

        <TextView
            android:id="@+id/tvBanDetails"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:lineSpacingExtra="4dp"
            android:text="Your Agent Node has been permanently blacklisted from the Spectre Enclave for serious protocol violations.\n\nAll real-time channels have been severed and cryptographic keys revoked."
            android:textColor="#B0BEC5"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/tvBanReason"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_pill_accent"
            android:backgroundTint="#25FF1744"
            android:paddingHorizontal="14dp"
            android:paddingVertical="6dp"
            android:text="REASON: PROTOCOL VIOLATION"
            android:textColor="#FF5252"
            android:textSize="11sp"
            android:fontFamily="monospace" />

        <Button
            android:id="@+id/btnExitBanned"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:background="@drawable/bg_rounded_primary"
            android:backgroundTint="#FF1744"
            android:paddingHorizontal="32dp"
            android:text="TERMINATE APP"
            android:textColor="#FFFFFF"
            android:textStyle="bold" />
    </LinearLayout>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:layout_centerHorizontal="true"
        android:letterSpacing="0.06"
        android:text="PSIRA NETWORK COMMAND // ZERO-TRUST PROTOCOL"
        android:textColor="#546E7A"
        android:textSize="10sp"
        android:fontFamily="monospace" />

</RelativeLayout>
