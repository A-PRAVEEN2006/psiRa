<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/gameRootLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#FAF8EF"
    android:padding="20dp">

    <!-- Top Header Bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="16dp">

        <TextView
            android:id="@+id/tvGameLogo"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="2048"
            android:textColor="#776E65"
            android:textSize="44sp"
            android:textStyle="bold" />

        <!-- Score & Best Badges -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <LinearLayout
                android:id="@+id/layoutScoreBadge"
                android:layout_width="74dp"
                android:layout_height="54dp"
                android:orientation="vertical"
                android:background="#BBADA0"
                android:gravity="center"
                android:padding="4dp"
                android:layout_marginEnd="8dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="SCORE"
                    android:textColor="#EEE4DA"
                    android:textSize="10sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvGameScore"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0"
                    android:textColor="#FFFFFF"
                    android:textSize="18sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/layoutBestBadge"
                android:layout_width="74dp"
                android:layout_height="54dp"
                android:orientation="vertical"
                android:background="#BBADA0"
                android:gravity="center"
                android:padding="4dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="BEST"
                    android:textColor="#EEE4DA"
                    android:textSize="10sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvGameBestScore"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0"
                    android:textColor="#FFFFFF"
                    android:textSize="18sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <!-- Subtitle and Controls -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="20dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Join the numbers and get to the 2048 tile!"
            android:textColor="#776E65"
            android:textSize="13sp" />

        <Button
            android:id="@+id/btnNewGame"
            android:layout_width="wrap_content"
            android:layout_height="38dp"
            android:text="New Game"
            android:textSize="12sp"
            android:textStyle="bold"
            android:backgroundTint="#8F7A66"
            android:textColor="#FFFFFF" />
    </LinearLayout>

    <!-- 4x4 Game Board Container -->
    <androidx.cardview.widget.CardView
        android:id="@+id/cardGameBoard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardCornerRadius="8dp"
        app:cardElevation="4dp"
        app:cardBackgroundColor="#BBADA0">

        <TableLayout
            android:id="@+id/tableGameBoard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="8dp"
            android:stretchColumns="*">

            <TableRow android:layout_marginBottom="8dp">
                <TextView android:id="@+id/tile_0_0" android:layout_width="0dp" android:layout_height="72dp" android:layout_margin="4dp" android:gravity="center" android:textSize="22sp" android:textStyle="bold" />
                <TextView android:id="@+id/tile_0_1" android:layout_width="0dp" android:layout_height="72dp" android:layout_margin="4dp" android:gravity="center" android:textSize="22sp" android:textStyle="bold" />
                <TextView android:id="@+id/tile_0_2" android:layout_width="0dp" android:layout_height="72dp" android:layout_margin="4dp" android:gravity="center" android:textSize="22sp" android:textStyle="bold" />
                <TextView android:id="@+id/tile_0_3" android:layout_width="0dp" android:layout_height="72dp" android:layout_margin="4dp" android:gravity="center" android:textSize="22sp" android:textStyle="bold" />
            </TableRow>

            <TableRow android:layout_marginBottom="8dp">
                <TextView android:id="@+id/tile_1_0" android:layout_width="0dp" android:layout_height="72dp" android:layout_margin="4dp" android:gravity="center" android:textSize="22sp" android:textStyle="bold" />
                <TextView android:id="@+id/tile_1_1" android:layout_width="0dp" android:layout_height="72dp" android:layout_margin="4dp" android:gravity="center" android:textSize="22sp" android:textStyle="bold" />
                <TextView android:id="@+id/tile_1_2" android:layout_width="0dp" android:layout_height="72dp" android:layout_margin="4dp" android:gravity="center" android:textSize="22sp" android:textStyle="bold" />
                <TextView android:id="@+id/tile_1_3" android:layout_width="0dp" android:layout_height="72dp" android:layout_margin="4dp" android:gravity="center" android:textSize="22sp" android:textStyle="bold" />
            </TableRow>

            <TableRow android:layout_marginBottom="8dp">
                <TextView android:id="@+id/tile_2_0" android:layout_width="0dp" android:layout_height="72dp" android:layout_margin="4dp" android:gravity="center" android:textSize="22sp" android:textStyle="bold" />
                <TextView android:id="@+id/tile_2_1" android:layout_width="0dp" android:layout_height="72dp" android:layout_margin="4dp" android:gravity="center" android:textSize="22sp" android:textStyle="bold" />
                <TextView android:id="@+id/tile_2_2" android:layout_width="0dp" android:layout_height="72dp" android:layout_margin="4dp" android:gravity="center" android:textSize="22sp" android:textStyle="bold" />
                <TextView android:id="@+id/tile_2_3" android:layout_width="0dp" android:layout_height="72dp" android:layout_margin="4dp" android:gravity="center" android:textSize="22sp" android:textStyle="bold" />
            </TableRow>

            <TableRow>
                <TextView android:id="@+id/tile_3_0" android:layout_width="0dp" android:layout_height="72dp" android:layout_margin="4dp" android:gravity="center" android:textSize="22sp" android:textStyle="bold" />
                <TextView android:id="@+id/tile_3_1" android:layout_width="0dp" android:layout_height="72dp" android:layout_margin="4dp" android:gravity="center" android:textSize="22sp" android:textStyle="bold" />
                <TextView android:id="@+id/tile_3_2" android:layout_width="0dp" android:layout_height="72dp" android:layout_margin="4dp" android:gravity="center" android:textSize="22sp" android:textStyle="bold" />
                <TextView android:id="@+id/tile_3_3" android:layout_width="0dp" android:layout_height="72dp" android:layout_margin="4dp" android:gravity="center" android:textSize="22sp" android:textStyle="bold" />
            </TableRow>
        </TableLayout>
    </androidx.cardview.widget.CardView>

    <TextView
        android:id="@+id/tvGameHint"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="HOW TO PLAY: Swipe UP, DOWN, LEFT or RIGHT to merge matching tiles!"
        android:textColor="#8F7A66"
        android:textSize="12sp"
        android:gravity="center"
        android:layout_marginTop="20dp" />

</LinearLayout>
