<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#000000"
    android:padding="16dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="OVEREER DASHBOARD"
        android:textColor="#FF0000"
        android:textSize="24sp"
        android:textStyle="bold"
        android:textAlignment="center"
        android:letterSpacing="0.1"
        android:layout_marginBottom="16dp" />

    <Button
        android:id="@+id/btnGlobalBroadcast"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="SEND GLOBAL BROADCAST"
        android:backgroundTint="#FF0000"
        android:textColor="#FFFFFF"
        android:textStyle="bold"
        android:layout_marginBottom="8dp" />

    <Button
        android:id="@+id/btnRestoreIdentity"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="RESTORE TRUE IDENTITY"
        android:backgroundTint="#0000FF"
        android:textColor="#FFFFFF"
        android:textStyle="bold"
        android:layout_marginBottom="16dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Global Registration Roster"
        android:textColor="#00FF00"
        android:textSize="18sp"
        android:textStyle="bold"
        android:layout_marginBottom="8dp" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvGodUsers"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="#111111"
        android:layout_marginBottom="16dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Global Server Enclaves"
        android:textColor="#00FF00"
        android:textSize="18sp"
        android:textStyle="bold"
        android:layout_marginBottom="8dp" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvGodGroups"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="#111111" />

</LinearLayout>
