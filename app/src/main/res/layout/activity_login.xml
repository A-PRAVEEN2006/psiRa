<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?android:attr/colorBackground"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:minHeight="640dp"
        android:padding="28dp">

        <!-- ── Logo / Branding ── -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:layout_marginTop="40dp"
            android:layout_marginBottom="40dp">

            <TextView
                android:id="@+id/tvLoginTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="PsiRa"
                android:textSize="52sp"
                android:textStyle="bold"
                android:textColor="?attr/colorPrimary"
                android:letterSpacing="0.05" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="SPECTRE ENCLAVE"
                android:textSize="11sp"
                android:textStyle="bold"
                android:textColor="?attr/colorAccent"
                android:letterSpacing="0.3"
                android:layout_marginTop="4dp" />
        </LinearLayout>

        <!-- ── Mode Tab Row ── -->
        <LinearLayout
            android:id="@+id/layoutModeTabs"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:orientation="horizontal"
            android:background="@drawable/bg_rounded_input"
            android:padding="4dp"
            android:layout_marginBottom="28dp">

            <TextView
                android:id="@+id/tabLogin"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:text="Sign In"
                android:gravity="center"
                android:textSize="14sp"
                android:textStyle="bold"
                android:background="@drawable/bg_rounded_primary"
                android:textColor="?attr/colorOnPrimary" />

            <TextView
                android:id="@+id/tabRegister"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:text="Register"
                android:gravity="center"
                android:textSize="14sp"
                android:textColor="?attr/colorOnSurface"
                android:background="@null" />

        </LinearLayout>

        <!-- ── Email Field ── -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Email"
            android:textSize="12sp"
            android:textStyle="bold"
            android:textColor="?attr/colorOnSurface"
            android:letterSpacing="0.05"
            android:layout_marginBottom="6dp" />

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginBottom="16dp">

            <EditText
                android:id="@+id/editEmail"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/bg_rounded_input"
                android:hint="you@example.com"
                android:textColorHint="?attr/colorOnBackground"
                android:textColor="?attr/colorOnBackground"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:inputType="textEmailAddress"
                android:imeOptions="actionNext"
                android:elevation="2dp" />
        </FrameLayout>

        <!-- ── Password Field ── -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Password"
            android:textSize="12sp"
            android:textStyle="bold"
            android:textColor="?attr/colorOnSurface"
            android:letterSpacing="0.05"
            android:layout_marginBottom="6dp" />

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginBottom="8dp">

            <EditText
                android:id="@+id/editPassword"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/bg_rounded_input"
                android:hint="Min. 6 characters"
                android:textColorHint="?attr/colorOnBackground"
                android:textColor="?attr/colorOnBackground"
                android:paddingStart="16dp"
                android:paddingEnd="52dp"
                android:inputType="textPassword"
                android:imeOptions="actionDone"
                android:elevation="2dp" />

            <!-- Show / hide password eye icon -->
            <ImageView
                android:id="@+id/ivTogglePassword"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_gravity="end|center_vertical"
                android:layout_marginEnd="4dp"
                android:padding="10dp"
                android:src="@android:drawable/ic_menu_view"
                android:tint="?attr/colorOnBackground"
                android:contentDescription="Show password"
                android:clickable="true"
                android:focusable="true" />
        </FrameLayout>

        <!-- ── Register: confirm password (hidden by default) ── -->
        <TextView
            android:id="@+id/labelConfirmPassword"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Confirm Password"
            android:textSize="12sp"
            android:textStyle="bold"
            android:textColor="?attr/colorOnSurface"
            android:letterSpacing="0.05"
            android:layout_marginBottom="6dp"
            android:visibility="gone" />

        <FrameLayout
            android:id="@+id/frameConfirmPassword"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginBottom="8dp"
            android:visibility="gone">

            <EditText
                android:id="@+id/editConfirmPassword"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/bg_rounded_input"
                android:hint="Re-enter password"
                android:textColorHint="?attr/colorOnBackground"
                android:textColor="?attr/colorOnBackground"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:inputType="textPassword"
                android:elevation="2dp" />
        </FrameLayout>

        <!-- ── Register: display name (hidden by default) ── -->
        <TextView
            android:id="@+id/labelAlias"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Agent Alias"
            android:textSize="12sp"
            android:textStyle="bold"
            android:textColor="?attr/colorOnSurface"
            android:letterSpacing="0.05"
            android:layout_marginBottom="6dp"
            android:visibility="gone" />

        <FrameLayout
            android:id="@+id/frameAlias"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginBottom="8dp"
            android:visibility="gone">

            <EditText
                android:id="@+id/editAlias"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/bg_rounded_input"
                android:hint="Your display name"
                android:textColorHint="?attr/colorOnBackground"
                android:textColor="?attr/colorOnBackground"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:inputType="textPersonName"
                android:elevation="2dp" />
        </FrameLayout>

        <!-- ── Forgot Password (Login mode only) ── -->
        <TextView
            android:id="@+id/tvForgotPassword"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Forgot password? Reset via email"
            android:textSize="13sp"
            android:textColor="?attr/colorPrimary"
            android:gravity="end"
            android:layout_marginBottom="28dp"
            android:paddingTop="4dp"
            android:paddingBottom="4dp"
            android:clickable="true"
            android:focusable="true" />

        <!-- ── Primary Action Button ── -->
        <Button
            android:id="@+id/btnLogin"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:text="SIGN IN"
            android:textColor="?attr/colorOnPrimary"
            android:textSize="16sp"
            android:textStyle="bold"
            android:background="@drawable/bg_rounded_primary"
            android:layout_marginBottom="32dp" />

        <!-- ── Error / status message ── -->
        <TextView
            android:id="@+id/tvLoginError"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text=""
            android:textSize="13sp"
            android:textColor="#FF6B6B"
            android:gravity="center"
            android:layout_marginBottom="16dp"
            android:visibility="gone" />

        <!-- ── Bottom spacer ── -->
        <View
            android:layout_width="match_parent"
            android:layout_height="24dp" />

    </LinearLayout>
</androidx.core.widget.NestedScrollView>