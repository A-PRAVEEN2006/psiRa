<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="?android:attr/colorBackground"
    android:gravity="center"
    android:padding="32dp">

    <TextView
        android:id="@+id/tvLoginTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="PsiRa"
        android:textAlignment="center"
        android:textSize="48sp"
        android:textStyle="bold"
        android:textColor="?attr/colorPrimary"
        android:letterSpacing="0.1"
        android:layout_marginBottom="8dp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="SECURE AGENT AUTHENTICATION"
        android:textAlignment="center"
        android:textSize="12sp"
        android:textStyle="bold"
        android:textColor="?attr/colorAccent"
        android:letterSpacing="0.2"
        android:layout_marginBottom="40dp" />

    <EditText
        android:id="@+id/editEmail"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:background="@drawable/bg_rounded_input"
        android:hint="Agent ID (Email)"
        android:textColorHint="?attr/colorOnBackground"
        android:textColor="?attr/colorOnBackground"
        android:padding="16dp"
        android:inputType="textEmailAddress"
        android:layout_marginBottom="20dp"
        android:elevation="2dp" />

    <EditText
        android:id="@+id/editPassword"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:background="@drawable/bg_rounded_input"
        android:hint="Passphrase"
        android:textColorHint="?attr/colorOnBackground"
        android:textColor="?attr/colorOnBackground"
        android:padding="16dp"
        android:inputType="textPassword"
        android:layout_marginBottom="40dp"
        android:elevation="2dp" />

    <Button
        android:id="@+id/btnLogin"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:text="INITIALIZE CONNECTION"
        android:textColor="?attr/colorOnPrimary"
        android:textSize="16sp"
        android:textStyle="bold"
        android:background="@drawable/bg_rounded_primary"
        android:layout_marginBottom="20dp"/>

    <Button
        android:id="@+id/btnRegister"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:text="REGISTER NEW AGENT"
        android:textColor="?attr/colorPrimary"
        android:textSize="16sp"
        android:backgroundTint="?attr/colorSurface" />

</LinearLayout>